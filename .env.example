# Higgsfield credentials — required server-side. Never expose to the browser.
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here

# Base URL of the Higgsfield REST API. Change if your account uses a different host.
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# Default model/endpoint identifier for video generation.
# Adjust to match the exact model id your Higgsfield plan exposes (e.g. "dop", "speak", etc.).
HIGGSFIELD_VIDEO_MODEL=dop

# Single shared password gate for the dashboard. Leave empty to disable auth (NOT recommended).
DASHBOARD_PASSWORD=change-me
