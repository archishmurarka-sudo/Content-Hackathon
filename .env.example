# Single shared password to log into the dashboard.
DASHBOARD_PASSWORD=change-me

# Gemini API key — used by the storyboard generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Higgsfield (used by the video-render layer, wired in next).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai
HIGGSFIELD_VIDEO_MODEL=dop

# YouTube Data API v3 — used to pull reference video metadata as seed prototypes.
YOUTUBE_API_KEY=

# Periskope (used by the WhatsApp-delivery layer, wired in next).
PERISKOPE_API_KEY=
PERISKOPE_PHONE=

# Cloudflare R2 (used to host finished assets so WhatsApp can fetch them).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
