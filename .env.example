# Single shared password to log into the dashboard.
DASHBOARD_PASSWORD=change-me

# Gemini API key — used by the storyboard generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Video renderer — pick one provider. Default "fal"; set "openrouter" to use Veo.
VIDEO_PROVIDER=fal

# OpenRouter — unified video API. Default model is Veo 3.1 Fast (~$0.10/sec,
# native synced audio). Swap with OPENROUTER_VIDEO_MODEL:
#   google/veo-3.1          (full quality, ~$0.40/sec, audio)
#   google/veo-3.1-fast     (cheapest with audio, default)
#   google/veo-3.1-lite     (no audio, cheapest overall)
#   openai/sora-2-pro
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=google/veo-3.1-fast

# fal.ai — alternative video renderer (Kling / Luma / Runway / Minimax).
FAL_API_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# Higgsfield (legacy — kept for compatibility; the active renderer is fal above).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai
HIGGSFIELD_VIDEO_MODEL=dop

# OpenAI — used for Meta ad static image generation (gpt-image-2).
# gpt-image-2 is the current frontier image model; same endpoint shape as
# gpt-image-1 (POST /v1/images/generations). Override the model env var if
# you need to fall back to gpt-image-1.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# YouTube Data API v3 — used to pull reference video metadata as seed prototypes.
YOUTUBE_API_KEY=

# Apify — used to scrape new TikTok creators on demand.
# Actor defaults to `clockworks~tiktok-scraper`; override only if needed.
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# Resend — transactional email used for "Send to creator" (email channel).
# RESEND_FROM must be a verified sender on your Resend account. For trial,
# Resend's onboarding sender works: "Mosaic <onboarding@resend.dev>".
RESEND_API_KEY=
RESEND_FROM=Mosaic Creator <onboarding@resend.dev>

# Periskope — WhatsApp Business API for auto-delivery to creators.
# PERISKOPE_PHONE is the sender (your number, country code, no '+').
PERISKOPE_API_KEY=
PERISKOPE_API_BASE=https://api.periskope.app/v1
PERISKOPE_PHONE=

# Optional — base URL used in outgoing email links / WhatsApp captions.
# Defaults to the request origin; set this to override (e.g. Railway domain).
PUBLIC_BASE_URL=

# Cloudflare R2 (used to host finished assets so WhatsApp can fetch them).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
